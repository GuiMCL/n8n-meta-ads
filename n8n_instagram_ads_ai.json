      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b=$('Validar briefing').first().json;const raw=$input.first().json.choices?.[0]?.message?.content;if(!raw)throw Error('IA sem resposta');const c=JSON.parse(raw);for(const k of ['headline','primary_text','image_prompt','video_prompt'])if(!c[k])throw Error('Campo IA faltando '+k);return [{json:{...b,copy:c}}];",
        "mode": "runOnceForAllItems"
      },
