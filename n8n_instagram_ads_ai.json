    {
      "parameters": {
        "jsCode": "const b=$input.first().json.body||{}; const secret=$input.first().json.headers?.['x-ads-secret'];if(!secret||secret!==$env.ADS_WEBHOOK_SECRET)throw Error('Unauthorized');const title=String(b.nome||'').trim();const product=String(b.produto||'').trim();const url=String(b.url||'').trim();const budget=Number(b.orcamento_diario||0);if(!title||!product||!/^https:\\/\\//.test(url)||!Number.isFinite(budget)||budget<10||budget>1000)throw Error('Briefing invalido; orcamento entre R$10 e R$1000');const id='ads-'+$execution.id;const obj={id,nome:title,produto:product,url,orcamento_diario:budget,objetivo:'OUTCOME_TRAFFIC',pais:'BR',idade_min:21,idade_max:60,publico:String(b.publico||'adultos interessados no produto'),cidade:String(b.cidade||'Brasil'),pagina_id:String(b.pagina_id||$env.META_PAGE_ID||''),instagram_actor_id:String(b.instagram_actor_id||$env.META_INSTAGRAM_ACTOR_ID||''),conta:String(b.conta||$env.META_AD_ACCOUNT_ID||'').replace(/^act_/,''),tipo_midia:['image','video'].includes(b.tipo_midia)?b.tipo_midia:'image'};if(!/^\\d+$/.test(obj.pagina_id)||!/^\\d+$/.test(obj.conta))throw Error('IDs de pagina e conta faltando');return [{json:obj}];",
        "mode": "runOnceForAllItems"
      },
      "id": "43270e16-6361-4962-83ac-88d2cbf2ca4a",
      "name": "Validar briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
